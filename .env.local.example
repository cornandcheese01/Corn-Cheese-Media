# Copy this file to .env.local and fill in real values.
# .env.local is already in .gitignore — never commit it.

# ── Google Service Account ────────────────────────────────────────────────────
# The email address of the service account (ends with @...iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The private key from the service-account JSON. Keep the -----BEGIN ... END----- lines.
# In .env.local, write the key on ONE LINE with literal \n between each line, e.g.:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_REAL_KEY\n-----END PRIVATE KEY-----\n"

# ── Google Sheet ──────────────────────────────────────────────────────────────
# The long ID in the Sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here

# Name of the tab inside the spreadsheet (default: Enquiries)
GOOGLE_SHEET_TAB=Enquiries
